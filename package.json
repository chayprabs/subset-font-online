{
  "name": "subset-font-online",
  "version": "1.0.0",
  "private": true,
  "description": "Subset, convert and QA TTF, OTF, WOFF and WOFF2 fonts online",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @fontops/web dev",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @fontops/web test:e2e"
  },
  "engines": {
    "node": ">=22"
  }
}
